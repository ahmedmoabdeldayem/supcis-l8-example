# staging.env — shared staging server
# Values injected by CI/CD pipeline via GitLab CI variables — never commit real values here

export DB_TNS=${STAGING_DB_TNS}
export DB_USER=${STAGING_DB_USER}
export DB_PASS=${STAGING_DB_PASS}
export API_KEY=${STAGING_API_KEY}
export HTTP_PORT=8080
export AUTOSTORE_API_KEY=${STAGING_AUTOSTORE_KEY}
export LOG_LEVEL=INFO
