# development.env — local developer machine settings
# Copy this file, fill in your values, and source it:
#   source config/environments/development.env

export DB_TNS=localhost/XEPDB1
export DB_USER=<replace-me>
export DB_PASS=<replace-me>
export API_KEY=<replace-me>
export HTTP_PORT=8080
export AUTOSTORE_API_KEY=<replace-me>
export LOG_LEVEL=DEBUG
