# production.env — customer site deployment
# All values come from the secure vault / environment injection at deploy time
# This file is a template only — real values are NEVER stored in git

export DB_TNS=${PROD_DB_TNS}
export DB_USER=${PROD_DB_USER}
export DB_PASS=${PROD_DB_PASS}
export API_KEY=${PROD_API_KEY}
export HTTP_PORT=8080
export AUTOSTORE_API_KEY=${PROD_AUTOSTORE_KEY}
export LOG_LEVEL=WARN
